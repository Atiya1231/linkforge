# Database Connection (Neon Serverless PostgreSQL recommended)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/linkforge?sslmode=require"

# JWT Secret for LinkForge User & Guest Authentication (minimum 32 characters)
JWT_SECRET="replace-with-a-secure-random-32-character-secret-key"

# Application Base URL (for short URL resolution & redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
